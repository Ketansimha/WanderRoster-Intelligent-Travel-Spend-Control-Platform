<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Total_Estimated_Cost__c</fullName>
    <description>Calculated total estimated trip budget</description>
    <externalId>false</externalId>
    <formula>BLANKVALUE(Estimated_Transport_Cost__c, 0) + BLANKVALUE(Estimated_Accommodation_Cost__c, 0) + BLANKVALUE(Estimated_Food_Cost__c, 0) + BLANKVALUE(Estimated_Local_Transport_Cost__c, 0) + BLANKVALUE(Estimated_Other_Cost__c, 0)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Total Estimated Cost (INR)</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <type>Currency</type>
</CustomField>
